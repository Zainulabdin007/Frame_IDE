	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#A2A2AA", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted", "punctuation.definition.string"],
			"settings": { "foreground": "#7A4BB8" }
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
			"settings": { "foreground": "#8B2FD6" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
			"settings": { "foreground": "#C96A32" }
		},
		{
			"scope": ["variable", "entity.name.variable", "variable.other.readwrite"],
			"settings": { "foreground": "#33333A" }
		},
		{
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#4A4A52" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#B87514" }
		},
		{
			"scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"],
			"settings": { "foreground": "#2277A8" }
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#8B2FD6" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#7A4BB8" }
		},
		{
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#7A7A82" }
		}
	]
}
