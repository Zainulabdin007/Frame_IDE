	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment", "comment.line", "comment.block"],
			"settings": { "foreground": "#5A5A60", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": { "foreground": "#C9A0FF" }
		},
		{
			"scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "keyword.operator.new"],
			"settings": { "foreground": "#AF50FF" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": { "foreground": "#E8874A" }
		},
		{
			"scope": ["variable", "variable.other", "meta.definition.variable"],
			"settings": { "foreground": "#D6D6DA" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#E8874A" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
			"settings": { "foreground": "#E1BDFF" }
		},
		{
			"scope": ["punctuation", "meta.brace", "meta.delimiter"],
			"settings": { "foreground": "#8A8A90" }
		},
		{
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": { "foreground": "#AF50FF" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#E8874A" }
		},
		{
			"scope": ["markup.heading"],
			"settings": { "foreground": "#E1BDFF", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold", "foreground": "#EDEDF0" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": { "foreground": "#C9A0FF" }
		}
	]
}
